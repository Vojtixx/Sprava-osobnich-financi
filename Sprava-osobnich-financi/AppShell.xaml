<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Sprava_osobnich_financi.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:Sprava_osobnich_financi.Pages"
    Title="Správa financí"
    Shell.FlyoutBehavior="Disabled">

    <!--
        Spodní navigační lišta (Material 3 "Navigation bar") se třemi záložkami.
        Route slouží pro absolutní navigaci, např. Shell.Current.GoToAsync("///SettingsTab").
        Formulář AddTransactionPage tu záměrně není – registruje se v AppShell.xaml.cs
        a otevírá se z Dashboardu přes URI.
    -->
    <TabBar>
        <ShellContent
            Title="Přehled"
            Icon="tab_home.png"
            Route="DashboardTab"
            ContentTemplate="{DataTemplate pages:DashboardPage}" />

        <ShellContent
            Title="Kurzy"
            Icon="tab_rates.png"
            Route="ExchangeRatesTab"
            ContentTemplate="{DataTemplate pages:ExchangeRatesPage}" />

        <ShellContent
            Title="Nastavení"
            Icon="tab_settings.png"
            Route="SettingsTab"
            ContentTemplate="{DataTemplate pages:Settings}" />
    </TabBar>

</Shell>
